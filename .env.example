# ==============================
# PostgreSQL
# ==============================
DB_USER=stockpro
DB_PASSWORD=123
DB_DB=stockpro_db
DB_TZ=Asia/Phnom_Penh
DB_PGTZ=Asia/Phnom_Penh

# ==============================
# MinIO
# ==============================
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=stockproadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=stockproadmin
MINIO_SECRET_KEY=123
MINIO_BUCKET=stockpro
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_URL_EXPIRY=3600

# ==============================
# NGINX
# ==============================
NGINX_SERVER_NAME=
NGINX_CLIENT_BODY_MAX_SIZE=100M